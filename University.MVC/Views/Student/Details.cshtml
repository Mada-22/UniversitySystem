@model University.MVC.Models.StudentViewModel

@{
    ViewData["Title"] = "Student Details";
}

<h1>Student Details</h1>

<dl class="row">

    <dt class="col-sm-3">Student ID</dt>
    <dd class="col-sm-9">@Model.StudentID</dd>

    <dt class="col-sm-3">First Name</dt>
    <dd class="col-sm-9">@Model.FirstName</dd>

    <dt class="col-sm-3">Last Name</dt>
    <dd class="col-sm-9">@Model.LastName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Age</dt>
    <dd class="col-sm-9">@Model.Age</dd>

    <dt class="col-sm-3">Gender</dt>
    <dd class="col-sm-9">@Model.Gender</dd>

    <dt class="col-sm-3">Department ID</dt>
    <dd class="col-sm-9">@Model.DepartmentID</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

</dl>

<a asp-action="Edit"
   asp-route-id="@Model.StudentID"
   class="btn btn-primary">
    Edit
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>