@model University.MVC.Models.DepartmentViewModel

@{
    ViewData["Title"] = "Department Details";
}

<h1>Department Details</h1>

<dl class="row">

    <dt class="col-sm-3">
        Department ID
    </dt>

    <dd class="col-sm-9">
        @Model.DepartmentID
    </dd>


    <dt class="col-sm-3">
        Department Name
    </dt>

    <dd class="col-sm-9">
        @Model.DepartmentName
    </dd>


    <dt class="col-sm-3">
        Building
    </dt>

    <dd class="col-sm-9">
        @Model.Building
    </dd>


    <dt class="col-sm-3">
        Budget
    </dt>

    <dd class="col-sm-9">
        @Model.Budget
    </dd>


    <dt class="col-sm-3">
        Status
    </dt>

    <dd class="col-sm-9">
        @Model.Status
    </dd>

</dl>

<a asp-action="Edit"
   asp-route-id="@Model.DepartmentID"
   class="btn btn-primary">
    Edit
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>
