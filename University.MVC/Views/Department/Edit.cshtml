@model University.MVC.Models.DepartmentViewModel

@{
    ViewData["Title"] = "Edit Department";
}

<h1>Edit Department</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="DepartmentID" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="form-group">
        <label asp-for="DepartmentName"></label>
        <input asp-for="DepartmentName" class="form-control" />
        <span asp-validation-for="DepartmentName"
              class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Building"></label>
        <input asp-for="Building" class="form-control" />
        <span asp-validation-for="Building"
              class="text-danger"></span>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>